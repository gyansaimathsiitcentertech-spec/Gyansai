{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized faculty administrator record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "minLength": 3
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "createdAt"]
    },
    "ExamFolder": {
      "title": "ExamFolder",
      "description": "Class or category folder organizing exams and uploaded questions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "targetClass": {
          "type": "string",
          "maxLength": 40
        },
        "color": {
          "type": "string",
          "maxLength": 40
        },
        "examCount": {
          "type": "integer"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "targetClass", "createdByUid", "createdAt", "updatedAt"]
    },
    "ExamPaper": {
      "title": "ExamPaper",
      "description": "Published or draft online CBT examination metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "codeLower": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "folderId": {
          "type": "string",
          "maxLength": 128
        },
        "folderName": {
          "type": "string",
          "maxLength": 160
        },
        "targetClass": {
          "type": "string",
          "maxLength": 40
        },
        "examCategory": {
          "type": "string",
          "maxLength": 40
        },
        "durationMinutes": {
          "type": "integer"
        },
        "totalMarks": {
          "type": "integer"
        },
        "positiveMarks": {
          "type": "integer"
        },
        "negativeMarks": {
          "type": "integer"
        },
        "passPercentage": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["Live", "Draft", "Scheduled", "Completed", "Active", "Published"]
        },
        "isPublic": {
          "type": "boolean"
        },
        "questionIds": {
          "type": "array",
          "description": "Bounded list of up to 200 question IDs belonging to this exam"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "code", "codeLower", "title", "targetClass", "durationMinutes", "status", "isPublic", "createdByUid", "createdAt", "updatedAt"]
    },
    "ExamQuestion": {
      "title": "ExamQuestion",
      "description": "Individual question document preserving original image URL/path and text metadata scoped to an exam",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "examId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderIndex": {
          "type": "integer"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "subject": {
          "type": "string",
          "maxLength": 80
        },
        "chapter": {
          "type": "string",
          "maxLength": 160
        },
        "topic": {
          "type": "string",
          "maxLength": 160
        },
        "type": {
          "type": "string",
          "enum": ["single_choice", "multiple_choice", "numerical", "integer"]
        },
        "questionType": {
          "type": "string",
          "enum": ["image", "text"]
        },
        "difficulty": {
          "type": "string",
          "maxLength": 40
        },
        "targetClass": {
          "type": "string",
          "maxLength": 40
        },
        "folderId": {
          "type": "string",
          "maxLength": 128
        },
        "folderName": {
          "type": "string",
          "maxLength": 160
        },
        "tag": {
          "type": "string",
          "maxLength": 40
        },
        "questionText": {
          "type": "string",
          "maxLength": 4000
        },
        "questionImageUrl": {
          "type": "string",
          "maxLength": 900000
        },
        "questionImagePath": {
          "type": "string",
          "maxLength": 300
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 900000
        },
        "formulaNote": {
          "type": "string",
          "maxLength": 1000
        },
        "options": {
          "type": "array",
          "description": "Up to 6 MCQ choice maps"
        },
        "correctAnswer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "marks": {
          "type": "integer"
        },
        "negativeMarks": {
          "type": "integer"
        },
        "marksPositive": {
          "type": "integer"
        },
        "marksNegative": {
          "type": "integer"
        },
        "explanation": {
          "type": "string",
          "maxLength": 3000
        },
        "isPublic": {
          "type": "boolean"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "examId", "code", "subject", "type", "correctAnswer", "marksPositive", "marksNegative", "isPublic", "createdByUid", "createdAt"]
    },
    "PublicRegistration": {
      "title": "PublicRegistration",
      "description": "Write-once candidate registration submitted via shared exam link",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20
        },
        "targetClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "collegeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rollNo": {
          "type": "string",
          "maxLength": 60
        },
        "examId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "examTitle": {
          "type": "string",
          "maxLength": 200
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "phone", "targetClass", "collegeName", "examId", "submittedAt"]
    },
    "ExamAttempt": {
      "title": "ExamAttempt",
      "description": "Write-once submitted CBT exam attempt and score summary",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "examId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "examTitle": {
          "type": "string",
          "maxLength": 200
        },
        "examCode": {
          "type": "string",
          "maxLength": 80
        },
        "studentId": {
          "type": "string",
          "maxLength": 128
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "studentRollNo": {
          "type": "string",
          "maxLength": 60
        },
        "studentPhone": {
          "type": "string",
          "maxLength": 20
        },
        "studentCollege": {
          "type": "string",
          "maxLength": 200
        },
        "totalScore": {
          "type": "number"
        },
        "maxScore": {
          "type": "number"
        },
        "percentage": {
          "type": "number"
        },
        "accuracy": {
          "type": "number"
        },
        "correctCount": {
          "type": "integer"
        },
        "incorrectCount": {
          "type": "integer"
        },
        "unattemptedCount": {
          "type": "integer"
        },
        "timeTakenMinutes": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["Evaluated", "Submitted"]
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "examId", "examTitle", "studentName", "totalScore", "maxScore", "correctCount", "incorrectCount", "unattemptedCount", "status", "submittedAt"]
    },
    "PortalSettings": {
      "title": "PortalSettings",
      "description": "Publicly readable institute branding, hero, contact, UPI checkout, and SEO settings managed exclusively by verified admins (never stores passwords)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "instituteName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "tagline": {
          "type": "string",
          "maxLength": 240
        },
        "storageTag": {
          "type": "string",
          "maxLength": 80
        },
        "directorName": {
          "type": "string",
          "maxLength": 120
        },
        "directorDesignation": {
          "type": "string",
          "maxLength": 160
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "whatsapp": {
          "type": "string",
          "maxLength": 40
        },
        "address": {
          "type": "string",
          "maxLength": 500
        },
        "city": {
          "type": "string",
          "maxLength": 80
        },
        "state": {
          "type": "string",
          "maxLength": 80
        },
        "pinCode": {
          "type": "string",
          "maxLength": 20
        },
        "website": {
          "type": "string",
          "maxLength": 300
        },
        "academicYear": {
          "type": "string",
          "maxLength": 40
        },
        "defaultNegativeMarking": {
          "type": "number"
        },
        "defaultPositiveMarking": {
          "type": "number"
        },
        "defaultExamDurationMinutes": {
          "type": "integer"
        },
        "allowResultReviewImmediately": {
          "type": "boolean"
        },
        "watermarkRollNumber": {
          "type": "boolean"
        },
        "enforceFullScreenInExam": {
          "type": "boolean"
        },
        "logoUrl": {
          "type": "string",
          "maxLength": 450000
        },
        "logoSizeW": {
          "type": "string",
          "maxLength": 20
        },
        "logoSizeH": {
          "type": "string",
          "maxLength": 20
        },
        "heroImageUrl": {
          "type": "string",
          "maxLength": 450000
        },
        "heroTitle": {
          "type": "string",
          "maxLength": 240
        },
        "heroSubtitle": {
          "type": "string",
          "maxLength": 600
        },
        "primaryCTA": {
          "type": "string",
          "maxLength": 80
        },
        "secondaryCTA": {
          "type": "string",
          "maxLength": 80
        },
        "faviconUrl": {
          "type": "string",
          "maxLength": 450000
        },
        "primaryColor": {
          "type": "string",
          "maxLength": 32
        },
        "upiId": {
          "type": "string",
          "maxLength": 120
        },
        "bankName": {
          "type": "string",
          "maxLength": 160
        },
        "accountNo": {
          "type": "string",
          "maxLength": 60
        },
        "ifsc": {
          "type": "string",
          "maxLength": 40
        },
        "upiQrCodeUrl": {
          "type": "string",
          "maxLength": 450000
        },
        "youtube": {
          "type": "string",
          "maxLength": 300
        },
        "instagram": {
          "type": "string",
          "maxLength": 300
        },
        "twitter": {
          "type": "string",
          "maxLength": 300
        },
        "facebook": {
          "type": "string",
          "maxLength": 300
        },
        "metaTitle": {
          "type": "string",
          "maxLength": 200
        },
        "metaDescription": {
          "type": "string",
          "maxLength": 500
        },
        "googleAnalyticsId": {
          "type": "string",
          "maxLength": 60
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "instituteName", "createdByUid", "createdAt", "updatedAt"]
    },
    "PortalCatalog": {
      "title": "PortalCatalog",
      "description": "Publicly readable portal catalog collection document (courses, test_series, batches, study_materials, notifications, teachers_public) containing bounded native item maps managed by verified admins",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["courses", "test_series", "batches", "study_materials", "notifications", "teachers_public"]
        },
        "isPublic": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "description": "Bounded list of up to 100 native item maps (no PII)"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "isPublic", "items", "createdByUid", "createdAt", "updatedAt"]
    },
    "AdminWorkspace": {
      "title": "AdminWorkspace",
      "description": "Strictly admin-only private operational documents (students, teachers_private, attendance, payments, question_bank, admin_security)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": ["students", "teachers_private", "attendance", "payments", "question_bank", "admin_security"]
        },
        "items": {
          "type": "array",
          "description": "Bounded list of up to 200 operational record maps"
        },
        "securityConfig": {
          "type": "object",
          "description": "Admin-only security settings map"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "createdByUid", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Authorized admin accounts"
    },
    "/folders/{folderId}": {
      "schema": {
        "$ref": "#/entities/ExamFolder"
      },
      "description": "Exam category folders created by faculty"
    },
    "/exams/{examId}": {
      "schema": {
        "$ref": "#/entities/ExamPaper"
      },
      "description": "Published and draft CBT exam papers"
    },
    "/exams/{examId}/questions/{questionId}": {
      "schema": {
        "$ref": "#/entities/ExamQuestion"
      },
      "description": "Individual question items and compressed image diagrams scoped to an exam"
    },
    "/public_registrations/{regId}": {
      "schema": {
        "$ref": "#/entities/PublicRegistration"
      },
      "description": "Write-once candidate intake for shared exam links (admin read-only)"
    },
    "/exam_attempts/{attemptId}": {
      "schema": {
        "$ref": "#/entities/ExamAttempt"
      },
      "description": "Write-once submitted CBT exam scorecards (admin read-only)"
    },
    "/portal_settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/PortalSettings"
      },
      "description": "Publicly readable institute branding, hero, contact, and checkout config (admin-only write)"
    },
    "/portal_catalog/{catalogId}": {
      "schema": {
        "$ref": "#/entities/PortalCatalog"
      },
      "description": "Publicly readable catalog collections (courses, test series, batches, study materials, notifications, public faculty profiles) written only by verified admins"
    },
    "/admin_workspace/{docId}": {
      "schema": {
        "$ref": "#/entities/AdminWorkspace"
      },
      "description": "Strictly admin-only operational records (students, private faculty contacts, attendance, payments, question bank, admin security)"
    }
  }
}

